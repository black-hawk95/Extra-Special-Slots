<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>BlackHawk-ExtraSpecialSlots.Client</AssemblyName>
    <RootNamespace>BlackHawk.ExtraSpecialSlots.Client</RootNamespace>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <Target Name="ValidateSptPath" BeforeTargets="ResolveReferences">
    <Error Condition="'$(SPTPath)' == ''"
           Text="Supply -p:SPTPath=PATH_TO_SPT_4.1.6 pointing to your SPT 4.1.6 installation." />
    <Error Condition="'$(SPTPath)' != '' and !Exists('$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll')"
           Text="SPTPath must point to an SPT 4.1.6 installation containing EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(SPTPath)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(SPTPath)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(SPTPath)\EscapeFromTarkov_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
